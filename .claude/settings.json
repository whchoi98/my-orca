{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(bash tests/run-all.sh:*)",
      "Bash(npm test --prefix infra-cdk:*)",
      "Bash(bash infra-tf/run-tests.sh:*)"
    ],
    "ask": [
      "Bash(bash deploy_orca.sh:*)",
      "Bash(bash deploy_orca_tf.sh:*)",
      "Bash(bash upgrade_orca.sh:*)",
      "Bash(bash cleanup.sh:*)",
      "Bash(bash set_password.sh:*)",
      "Bash(bash get_pairing_url.sh:*)",
      "Bash(npx cdk deploy:*)",
      "Bash(npx cdk destroy:*)",
      "Bash(npm run deploy:*)",
      "Bash(npm run destroy:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform -chdir=infra-tf/dedicated apply:*)",
      "Bash(terraform -chdir=infra-tf/dedicated destroy:*)",
      "Bash(terraform -chdir=infra-tf/attach apply:*)",
      "Bash(terraform -chdir=infra-tf/attach destroy:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(chmod 777:*)",
      "Bash(curl*| bash*)",
      "Bash(wget*| bash*)",
      "Bash(eval:*)",
      "Bash(python3 -c*import os*)",
      "Read(./.env)",
      "Read(./cdk-outputs.json)",
      "Read(./infra-tf/**/*.tfstate)",
      "Read(./infra-tf/**/*.tfstate.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secret-scan.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-doc-sync.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify.sh 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
