# 분석용 upstream stablyai/orca clone. 추적하지 않는다.
/orca/

# 자격 증명과 로컬 설정. 접속 암호는 어떤 파일에도 두지 않는다(배포 명령 앞에 한 번만 넘긴다).
.env
.env.*
!.env.example
.claude/settings.local.json

# 배포 출력에는 페어링 링크와 설정 코드가 평문으로 들어 있다.
cdk-outputs.json

# CDK가 조회해 둔 값(고정된 AMI ID). 계정 ID와 VPC ID가 들어 있다. 지우면 다음 배포에서 다시 조회한다.
infra-cdk/cdk.context.json

# Terraform. 상태 파일에는 X-Custom-Secret 값이 평문으로 들어 있다. 입력 값 파일과 계획 파일에는
# 인스턴스 ID와 ARN이 들어 있다. .terraform.lock.hcl(provider 버전과 해시)은 추적한다.
infra-tf/**/.terraform/
infra-tf/**/*.tfstate
infra-tf/**/*.tfstate.*
infra-tf/**/*.tfvars
infra-tf/**/*.tfvars.json
infra-tf/**/*.tfplan
infra-tf/**/.build/
crash.log

# 빌드 산출물과 의존성
node_modules/
infra-cdk/cdk.out/
infra-cdk/**/*.js
infra-cdk/**/*.d.ts
# CloudFront Function의 소스는 tsc 출력이 아니라 직접 쓴 JavaScript다
!infra-cdk/lib/functions/*.js
__pycache__/
*.pyc

# 편집기와 운영체제
.DS_Store
*.swp
.idea/
.vscode/
