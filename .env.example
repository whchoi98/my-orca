# 이 저장소의 스크립트가 읽는 환경 변수입니다. 스크립트는 .env 파일을 읽지 않으므로, 쓰려면 셸에서 export하거나 명령 앞에 붙입니다.
# 접속 암호(ORCA_WEB_PASSWORD)는 여기에도 .env에도 적지 않습니다. 배포 명령 앞에 한 번만 붙이거나 프롬프트에 입력합니다.

# 배포 리전. 비워 두면 AWS_DEFAULT_REGION, 그것도 없으면 ap-northeast-2를 씁니다.
AWS_REGION=ap-northeast-2

# 스택 이름. 비워 두면 OrcaServerStack, --attach 배포는 OrcaOnVscodeStack입니다.
STACK_NAME=

# Claude Code 알림 웹훅(선택). 비어 있으면 알림을 보내지 않습니다.
CLAUDE_NOTIFY_WEBHOOK=
